# Copy to .env and fill in. Everything is optional: the app works fully offline without these.
PORT=8787
HOST=127.0.0.1
APP_BASE_URL=http://localhost:5173
# DATA_FILE=server/data/store.json

# --- Google Calendar (optional) ---
# See docs/GOOGLE_CALENDAR_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/google/callback
# Any long random string (hashed to an AES-256-GCM key). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Optional AI tutor (server-side only, never sent to the browser) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
